# AI RSS Filter 环境变量配置 - Hugging Face Spaces

# ========== RSS 源配置 ==========
# RSS 源配置在 config/rss_sources.json 中

# ========== 模型配置 ==========
# MODEL_NAME=distilbert-base-uncased
# DEVICE=cpu

# ========== 过滤配置 ==========
# CONFIDENCE_THRESHOLD=0.7
# MIN_CONTENT_LENGTH=50
# SPAM_THRESHOLD=0.4

# ========== 服务器配置 ==========
# Hugging Face Spaces 自动使用端口 7860
PORT=7860

# ========== 可选：日志级别 ==========
# LOG_LEVEL=INFO
