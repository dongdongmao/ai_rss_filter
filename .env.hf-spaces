# AI RSS Filter 环境变量配置 - Hugging Face Spaces

# ========== 通知配置 ==========

# Telegram 通知
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email 通知
EMAIL_SENDER=
EMAIL_PASSWORD=

# ========== RSS 源配置 ==========
# RSS 源配置在 config/rss_sources.json 中

# ========== 模型配置 ==========
# 模型配置在 config/config.json 中
# 推荐在 Hugging Face Spaces 上使用轻量级模型来节省资源

# ========== 服务器配置 ==========
# Hugging Face Spaces 自动使用端口 7860
PORT=7860

# ========== 可选：代理配置 ==========
# HTTP_PROXY=
# HTTPS_PROXY=

# ========== 可选：日志级别 ==========
# LOG_LEVEL=INFO
